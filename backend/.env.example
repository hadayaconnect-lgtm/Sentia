# --- Fournisseur d'IA : "anthropic" (Claude, choisi pour le MVP), "openai", "gemini" ou "llama" ---
# Changer de fournisseur = changer ces variables, rien dans l'application Android.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Si AI_PROVIDER=openai : OPENAI_API_KEY (voir plus bas) + OPENAI_CHAT_MODEL=gpt-4.1
# Si AI_PROVIDER=gemini : GEMINI_API_KEY, GEMINI_MODEL (endpoint compatible OpenAI, GEMINI_BASE_URL)
# Si AI_PROVIDER=llama (accès à l'API Llama à vérifier de votre côté)
LLAMA_API_KEY=
LLAMA_BASE_URL=https://api.llama.com/compat/v1
LLAMA_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8

# --- Voix ---
OPENAI_API_KEY=
# Optionnel : forcer la langue de transcription (fr, ar…). Vide = détection automatique.
WHISPER_LANGUAGE=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Supabase (annuaire + compteurs) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Sécurité ---
# openssl rand -hex 32
DEVICE_HMAC_SECRET=
CRON_SECRET=
# Code d'accès facultatif, recommandé pendant le pilote (à saisir une fois dans Réglages). Vide = accès libre.
APP_ACCESS_CODE=

# Accepte les requêtes de l'application Android (en-tête x-client). Mettre false pour tout couper.
NATIVE_CLIENT_ENABLED=true

# --- Limites ---
USER_DAILY_LIMIT=150
GLOBAL_DAILY_LIMIT=3000
