<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/black" android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:id="@+id/suTitle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/yellow" android:textSize="30sp" android:textStyle="bold"
            android:accessibilityHeading="true" />
        <TextView android:id="@+id/suMessage"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:layout_marginBottom="24dp"
            android:textColor="@color/white" android:textSize="22sp"
            android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/suMain" style="@style/Sentia.BigButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/suLater" style="@style/Sentia.BigButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
