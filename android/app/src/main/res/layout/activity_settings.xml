<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/black">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <TextView style="@style/Sentia.Text" android:text="@string/set_language" android:textStyle="bold"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <Spinner android:id="@+id/spLanguage" android:layout_width="match_parent" android:layout_height="56dp" />

        <TextView style="@style/Sentia.Text" android:text="@string/set_profile" android:textStyle="bold"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" />
        <Spinner android:id="@+id/spProfile" android:layout_width="match_parent" android:layout_height="56dp" />

        <TextView style="@style/Sentia.Text" android:text="@string/set_sensitivity" android:textStyle="bold"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" />
        <Spinner android:id="@+id/spSensitivity" android:layout_width="match_parent" android:layout_height="56dp" />

        <androidx.appcompat.widget.SwitchCompat android:id="@+id/swShake"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
            android:layout_marginTop="16dp" android:text="@string/set_shake" android:textColor="@color/white" android:textSize="20sp" />
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/swVolume"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
            android:text="@string/set_volume" android:textColor="@color/white" android:textSize="20sp" />
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/swVoice"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
            android:text="@string/set_voice_replies" android:textColor="@color/white" android:textSize="20sp" />
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/swSounds"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
            android:text="@string/set_sounds" android:textColor="@color/white" android:textSize="20sp" />

        <TextView style="@style/Sentia.Text" android:text="@string/set_code" android:textStyle="bold"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" />
        <EditText android:id="@+id/etCode" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="56dp" android:inputType="textPassword" android:textColor="@color/white" android:textSize="20sp"
            android:importantForAutofill="no" />

        <Button android:id="@+id/btnBattery" style="@style/Sentia.BigButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/set_battery" android:textSize="18sp" />
        <Button android:id="@+id/btnA11y" style="@style/Sentia.BigButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/set_accessibility" android:textSize="18sp" />
        <Button android:id="@+id/btnTest" style="@style/Sentia.BigButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/set_test" android:textSize="18sp" />
        <TextView android:id="@+id/testStatus" style="@style/Sentia.Text"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite" android:textColor="@color/yellow" />
        <Button android:id="@+id/btnSave" style="@style/Sentia.BigButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/set_save" />
    </LinearLayout>
</ScrollView>
